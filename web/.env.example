# ============================================================
# MLA E-OFFICE — FRONTEND ENVIRONMENT VARIABLES (Vite)
# All variables MUST start with VITE_ to be accessible in browser
# ============================================================

# ── Backend API Configuration ──────────────────────────────
# Local Dev:   http://localhost:5000/api/v1
# Production:  https://api.eoffice.mlaname.in/api/v1 (or https://mla-eoffice-api.onrender.com/api/v1)
VITE_API_BASE_URL=http://localhost:5000/api/v1

# ── Application Metadata ────────────────────────────────────
VITE_APP_NAME=MLA E-Office
VITE_DEFAULT_LOCALE=mr

# ── Cloudinary Direct Upload Configuration ─────────────────
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=mla_eoffice
