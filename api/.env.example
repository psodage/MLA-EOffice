# ============================================================
# MLA E-OFFICE — BACKEND ENVIRONMENT VARIABLES
# Copy this file to .env and fill in real values
# NEVER commit .env to Git
# ============================================================

# ── Application ──────────────────────────────────────────────
NODE_ENV=development                    # 🟢 development | staging | production
PORT=5000                               # 🟢 Express server port
FRONTEND_URL=http://localhost:5173      # 🟡 CORS origin (e.g. https://eoffice.mlaname.in)
API_BASE_URL=http://localhost:5000      # 🟡 Self-reference API URL (e.g. https://api.eoffice.mlaname.in)

# ── Database (MySQL 8.x — Railway / Local) ───────────────────
DB_HOST=localhost                        # 🟡 Database host (e.g., containers-us-west-XXX.railway.app)
DB_PORT=3306                             # 🟢 Database port (e.g., 7890 for Railway)
DB_NAME=mla_eoffice_dev                  # 🟡 Database name (e.g., mla_eoffice_prod)
DB_USER=root                             # 🟡 Database username
DB_PASSWORD=your_database_password       # 🔴 Database password
DB_POOL_MIN=2                            # 🟢 Sequelize connection pool minimum
DB_POOL_MAX=10                           # 🟢 Sequelize connection pool maximum
DB_SSL=false                             # 🟢 Set true for SSL connections (Railway / Production)

# ── JWT Authentication ───────────────────────────────────────
JWT_SECRET=change_this_to_a_256bit_random_string   # 🔴 64-char hex secret for JWT signing
JWT_ACCESS_EXPIRY=24h                    # 🟢 Access token validity (e.g. 1h for prod, 24h for dev)
JWT_REFRESH_EXPIRY=7d                    # 🟢 Refresh token validity

# ── Bcrypt ───────────────────────────────────────────────────
BCRYPT_SALT_ROUNDS=12                    # 🟢 Password hash cost factor

# ── Cloudinary (File Storage) ────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name    # 🟡 Cloudinary cloud name
CLOUDINARY_API_KEY=your_api_key          # 🔴 Cloudinary API key
CLOUDINARY_API_SECRET=your_api_secret    # 🔴 Cloudinary API secret
CLOUDINARY_UPLOAD_PRESET=mla_eoffice     # 🟡 Upload preset name
FILE_MAX_SIZE_MB=10                      # 🟢 Max upload size in MB
FILE_ALLOWED_TYPES=image/jpeg,image/png,application/pdf,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet

# ── Google Gemini AI (Letter Drafting) ───────────────────────
GEMINI_API_KEY=your_gemini_api_key       # 🔴 Google Gemini API key
GEMINI_MODEL=gemini-2.0-flash           # 🟢 Gemini model
GEMINI_MAX_TOKENS=2048                   # 🟢 Max response tokens
GEMINI_TEMPERATURE=0.7                   # 🟢 Model temperature (0.0 - 1.0)

# ── Meta WhatsApp Cloud API ──────────────────────────────────
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id      # 🔴 Meta Phone Number ID
WHATSAPP_ACCESS_TOKEN=your_permanent_access_token   # 🔴 Meta permanent access token
WHATSAPP_VERIFY_TOKEN=your_webhook_verify_token     # 🔴 Webhook verification token
WHATSAPP_WABA_ID=your_waba_id                       # 🟡 WhatsApp Business Account ID
WHATSAPP_API_VERSION=v21.0                           # 🟢 Meta Graph API version
WHATSAPP_MAX_RETRIES=2                               # 🟢 Message retry count

# ── SMS Fallback (Optional) ─────────────────────────────────
SMS_PROVIDER=none                        # 🟢 none | msg91 | textlocal | twilio
SMS_API_KEY=your_sms_api_key             # 🔴 SMS API key
SMS_SENDER_ID=MLAOFF                     # 🟡 6-char sender ID

# ── Email / SMTP (Notifications) ────────────────────────────
SMTP_HOST=smtp.gmail.com                 # 🟡 SMTP server hostname
SMTP_PORT=587                            # 🟢 SMTP port
SMTP_SECURE=false                        # 🟢 true for port 465, false for 587
SMTP_USER=your_email@gmail.com           # 🟡 SMTP username
SMTP_PASSWORD=your_app_password          # 🔴 SMTP 16-char App Password
SMTP_FROM_NAME=MLA E-Office              # 🟢 Sender display name
SMTP_FROM_EMAIL=noreply@mlaeoffice.com   # 🟡 Sender email address
ADMIN_EMAIL=admin@mlaeoffice.com         # 🟡 System admin email address

# ── Office Hours & Timezone ──────────────────────────────────
OFFICE_HOURS_START=10:00                 # 🟢 Office opening time (HH:MM, 24hr)
OFFICE_HOURS_END=18:00                   # 🟢 Office closing time (HH:MM, 24hr)
TIMEZONE=Asia/Kolkata                    # 🟢 Timezone (IST)
OFFICE_HOURS_ENABLED=true                # 🟢 Enable office hours access restrictions

# ── Rate Limiting ────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000              # 🟢 Rate limit window in ms (15 mins)
RATE_LIMIT_MAX_REQUESTS=100              # 🟢 Max requests per window
LOGIN_RATE_LIMIT_MAX=5                   # 🟢 Max login attempts
LOGIN_LOCKOUT_MINUTES=15                 # 🟢 Lockout duration in minutes

# ── Logging (Winston) ────────────────────────────────────────
LOG_LEVEL=warn                           # 🟢 debug | info | warn | error
LOG_FILE_PATH=logs/app.log               # 🟢 Log file destination
LOG_MAX_SIZE=20m                         # 🟢 Max single log size before rotation
LOG_MAX_FILES=14d                        # 🟢 Retention period

# ── Cron / Scheduled Tasks ──────────────────────────────────
CRON_BIRTHDAY_GREETING=0 8 * * *        # 🟢 Daily 8:00 AM IST
CRON_ESCALATION_CHECK=0 9 * * 1-6       # 🟢 Daily 9:00 AM Mon-Sat
CRON_WHATSAPP_QUEUE=*/30 * * * * *      # 🟢 Every 30 seconds

# ── Backup (Production Only) ────────────────────────────────
BACKUP_ENABLED=true                      # 🟢 Enable automated backups
BACKUP_CRON=0 2 * * *                    # 🟢 Daily 2:00 AM IST
BACKUP_RETENTION_DAYS=30                 # 🟢 Backup retention in days
